# Desenvolvimento local. Não use estas credenciais fora da máquina.
DATABASE_URL=postgresql+psycopg://usiar:usiar@localhost:5433/usiar
# Runtime TypeScript/Cloudflare: use formato postgresql:// (sem driver SQLAlchemy)
# e conexão direta ou Supabase Session Pooler. Valores reais ficam fora do Git.
SUPABASE_URL=
SUPABASE_ANON_KEY=
ARTIFACT_STORAGE_PATH=var/artifacts
DOCUMENT_MAX_DOWNLOAD_BYTES=52428800

# Em production/prod, /docs, /redoc e /openapi.json ficam desabilitados por
# padrao. Defina API_DOCS_ENABLED=true somente com uma decisao explicita e
# protecao de implantacao apropriada.
ENVIRONMENT=development
API_DOCS_ENABLED=

# Selecione exatamente um autenticador. Em internal, gere um segredo base64url com
# ao menos 32 bytes aleatorios; nunca reutilize este segredo entre ambientes.
AUTH_MODE=oidc
INTERNAL_AUTH_RATE_LIMIT_KEY=

# Obrigatorios somente quando AUTH_MODE=oidc. Nao coloque tokens aqui.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS=RS256
OIDC_JWKS_CACHE_SECONDS=300

# Scheduler PNCP (desativado por padrão; nunca habilite em mais de um supervisor).
# COLLECTION_MODALITIES é obrigatória e deve conter apenas códigos confirmados.
COLLECTION_SCHEDULER_ENABLED=false
COLLECTION_TIMEZONE=America/Sao_Paulo
COLLECTION_SCHEDULE_TIMES=06:00,12:00,18:00
COLLECTION_MODALITIES=
COLLECTION_UF=SP
COLLECTION_PROFILE=USIAR/v2
COLLECTION_WINDOW_DAYS=2
COLLECTION_PAGE_SIZE=50
COLLECTION_MAX_PAGES=200
COLLECTION_TIMEOUT_SECONDS=30
COLLECTION_RETRY_ATTEMPTS=3
COLLECTION_RETRY_INITIAL_SECONDS=0.5
COLLECTION_RETRY_BACKOFF=2
COLLECTION_RETRY_MAX_SECONDS=8

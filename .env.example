# Desenvolvimento local. Não use estas credenciais fora da máquina.
DATABASE_URL=postgresql+psycopg://usiar:usiar@localhost:5433/usiar
ARTIFACT_STORAGE_PATH=var/artifacts
DOCUMENT_MAX_DOWNLOAD_BYTES=52428800

# Em production/prod, /docs, /redoc e /openapi.json ficam desabilitados por
# padrao. Defina API_DOCS_ENABLED=true somente com uma decisao explicita e
# protecao de implantacao apropriada.
ENVIRONMENT=development
API_DOCS_ENABLED=

# Selecione exatamente um autenticador. Em internal, gere um segredo base64url com
# ao menos 32 bytes aleatorios; nunca reutilize este segredo entre ambientes.
AUTH_MODE=oidc
INTERNAL_AUTH_RATE_LIMIT_KEY=

# Obrigatorios somente quando AUTH_MODE=oidc. Nao coloque tokens aqui.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS=RS256
OIDC_JWKS_CACHE_SECONDS=300

# Somente valores locais/placeholders. Guarde valores reais no ambiente/Cloudflare Secrets.
AUTH_MODE=supabase
APP_ORIGIN=http://127.0.0.1:3000
# PostgreSQL direto ou Supabase Session Pooler. Não use transaction pooler/Hyperdrive no coletor.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
API_PROFILE_ID=42227c23-f6ea-5a43-b640-56ed6eb6981c
API_PROFILE_CODE=

# Coletor PNCP do Worker (três Crons são declarados em wrangler.jsonc).
COLLECTION_MODALITIES=
COLLECTION_UF=SP
COLLECTION_PROFILE=USIAR/v2
COLLECTION_WINDOW_DAYS=2
COLLECTION_PAGE_SIZE=50
COLLECTION_MAX_PAGES=200
COLLECTION_TIMEOUT_SECONDS=30
COLLECTION_RETRY_ATTEMPTS=3

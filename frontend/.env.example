# Apenas configuração local. Nunca adicionar tokens a este arquivo.
APP_ORIGIN=http://127.0.0.1:3000
FASTAPI_BASE_URL=http://127.0.0.1:8000
API_TIMEOUT_MS=10000
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800
# Exatamente um perfil quando houver consultas por perfil.
API_PROFILE_ID=
API_PROFILE_CODE=
# Sem esses valores, login fica indisponível e rotas continuam protegidas.
OIDC_ISSUER=
OIDC_CLIENT_ID=
# client_secret_basic, client_secret_post ou none; conforme registro aprovado.
OIDC_CLIENT_AUTH_METHOD=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid dashboard:read
# Definir apenas se exigido pelo provedor. Não são intercambiáveis.
OIDC_RESOURCE=
OIDC_AUDIENCE=
# Algoritmo de assinatura do ID token, conforme provedor aprovado.
OIDC_ID_TOKEN_ALG=RS256
